#include <WiFi.h>

// ===================== CONFIGURACION =====================
const char* SSID = "TU_WIFI";
const char* PASSWORD = "TU_PASSWORD";

// IP DEL COMPUTADOR QUE EJECUTA PYTHON
IPAddress SERVER_IP(192, 168, 1, 100);
const uint16_t SERVER_PORT = 5000;

WiFiClient client;

// ===================== PINES =============================
const int PIN_JOY_X = 34;
const int PIN_JOY_Y = 35;
const int PIN_Z     = 32;

const int PIN_GRAB    = 25;
const int PIN_RELEASE = 26;
const int PIN_STOP    = 27;

// Centro aproximado de joystick
const int ADC_CENTER = 2048;
const int DEAD_ZONE = 220;

// 0=A drones, 1=B Baxter, 2=C Baxter suave
int mode = 0;

unsigned long lastSend = 0;
const unsigned long SEND_PERIOD_MS = 50;

bool oldGrab = HIGH;
bool oldRelease = HIGH;
bool oldStop = HIGH;

// ---------------------------------------------------------
float normalizeAxis(int value) {
  int delta = value - ADC_CENTER;

  if (abs(delta) < DEAD_ZONE) return 0.0f;

  float result;

  if (delta > 0) {
    result = (float)(delta - DEAD_ZONE) /
             (float)(4095 - ADC_CENTER - DEAD_ZONE);
  } else {
    result = (float)(delta + DEAD_ZONE) /
             (float)(ADC_CENTER - DEAD_ZONE);
  }

  return constrain(result, -1.0f, 1.0f);
}

// ---------------------------------------------------------
void connectWiFi() {
  Serial.print("Conectando a WiFi");

  WiFi.begin(SSID, PASSWORD);

  while (WiFi.status() != WL_CONNECTED) {
    delay(500);
    Serial.print(".");
  }

  Serial.println();
  Serial.println("WiFi conectado");
  Serial.print("IP ESP32: ");
  Serial.println(WiFi.localIP());
}

// ---------------------------------------------------------
void connectServer() {
  if (client.connected()) return;

  Serial.println("Conectando al servidor Python...");

  if (client.connect(SERVER_IP, SERVER_PORT)) {
    Serial.println("Servidor conectado");
    client.println("STOP");
  } else {
    Serial.println("No se pudo conectar al servidor");
  }
}

// ---------------------------------------------------------
void sendCommand(const String &cmd) {
  connectServer();

  if (client.connected()) {
    client.println(cmd);
    Serial.print("TX: ");
    Serial.println(cmd);
  }
}

// ---------------------------------------------------------
void setup() {
  Serial.begin(115200);

  pinMode(PIN_GRAB, INPUT_PULLUP);
  pinMode(PIN_RELEASE, INPUT_PULLUP);
  pinMode(PIN_STOP, INPUT_PULLUP);

  analogReadResolution(12);

  connectWiFi();
  connectServer();

  Serial.println("Consola ESP32 lista");
  Serial.println("Modo inicial: A - drones");
}

// ---------------------------------------------------------
void loop() {

  if (WiFi.status() != WL_CONNECTED) {
    connectWiFi();
  }

  connectServer();

  // -------- BOTONES --------
  bool grab = digitalRead(PIN_GRAB);
  bool release = digitalRead(PIN_RELEASE);
  bool stopButton = digitalRead(PIN_STOP);

  if (grab == LOW && oldGrab == HIGH) {
    sendCommand("GRAB");
  }

  if (release == LOW && oldRelease == HIGH) {
    sendCommand("RELEASE");
  }

  if (stopButton == LOW && oldStop == HIGH) {
    sendCommand("STOP");
  }

  oldGrab = grab;
  oldRelease = release;
  oldStop = stopButton;

  // -------- MOVIMIENTO --------
  if (millis() - lastSend >= SEND_PERIOD_MS) {

    lastSend = millis();

    float x = normalizeAxis(analogRead(PIN_JOY_X));
    float y = normalizeAxis(analogRead(PIN_JOY_Y));

    // El potenciómetro controla Z
    float z = normalizeAxis(analogRead(PIN_Z));

    String command;

    if (mode == 0) {
      command = "A," + String(x, 3) + "," +
                String(y, 3) + "," +
                String(z, 3);
    }
    else if (mode == 1) {
      command = "B," + String(x, 3) + "," +
                String(y, 3) + "," +
                String(z, 3);
    }
    else {
      command = "C," + String(x, 3) + "," +
                String(y, 3) + "," +
                String(z, 3);
    }

    sendCommand(command);
  }

  delay(2);
}
