"""
Parte A - Enjambre de drones (gym-pybullet-drones) controlado desde la ESP32.

Los drones despegan en formacion y se mueven del lugar A al B y al C.

Consola ESP32                          Teclado (modo --port omitido)
  Boton A  -> ir al lugar A            1
  Boton B  -> ir al lugar B            2
  Boton C  -> ir al lugar C            3
  Boton D  -> aterrizar / despegar     4
  Joystick izq (lx,ly) -> mover el enjambre en X/Y a mano   W A S D
  Joystick der (ry)    -> subir / bajar                      I / K

Arquitectura de control (cascada):
  ESP32 --serie--> setpoint del centro de la formacion (limitado en velocidad)
                 --> setpoint individual = centro + offset de cada dron
                 --> DSLPIDControl (PID de posicion + PID de actitud) --> RPM de los 4 motores
                 --> CtrlAviary (PyBullet)

Uso:
  python esp32_drones.py --port COM5            # Windows con ESP32
  python esp32_drones.py --port /dev/ttyUSB0    # Linux
  python esp32_drones.py                        # sin hardware: teclado
  python esp32_drones.py --demo --gui false     # recorrido A->B->C automatico sin ventana
"""
import argparse
import csv
import os
import sys
import time

import numpy as np
import pybullet as p

sys.path.insert(0, os.path.join(os.path.dirname(__file__), ".."))
from common.esp32_link import (BTN_A, BTN_B, BTN_C, BTN_D, EdgeDetector,  # noqa: E402
                               LowPass, open_link)

from gym_pybullet_drones.control.DSLPIDControl import DSLPIDControl  # noqa: E402
from gym_pybullet_drones.envs.CtrlAviary import CtrlAviary  # noqa: E402
from gym_pybullet_drones.utils.enums import DroneModel, Physics  # noqa: E402
from gym_pybullet_drones.utils.utils import str2bool, sync  # noqa: E402

# ---- Lugares A, B y C (x, y, z) en metros ---------------------------------
PLACES = {
    "A": np.array([0.0, 0.0, 1.0]),
    "B": np.array([2.0, 0.0, 1.0]),
    "C": np.array([2.0, 2.0, 1.0]),
}
GOTO_SPEED = 0.6      # m/s velocidad maxima del setpoint al ir a un lugar
MANUAL_SPEED = 1.0    # m/s velocidad con el joystick
Z_SPEED = 0.5         # m/s subida/bajada con el joystick
Z_MIN, Z_MAX, XY_LIM = 0.05, 2.5, 4.0
ARRIVE_TOL = 0.08     # m, tolerancia para considerar "llegado"
STICK_ACTIVE = 0.10   # umbral para que el joystick cancele el modo "ir a lugar"


def formation_offsets(n: int, radius: float = 0.35) -> np.ndarray:
    """Offsets (x,y,0) de los drones alrededor del centro; 1 dron -> sin offset."""
    if n == 1:
        return np.zeros((1, 3))
    ang = np.arange(n) * 2 * np.pi / n
    return np.stack([radius * np.cos(ang), radius * np.sin(ang), np.zeros(n)], axis=1)


def draw_places(client):
    for name, pos in PLACES.items():
        for axis in np.eye(3) * 0.15:
            p.addUserDebugLine(pos - axis, pos + axis, [1, 0, 0], 2, physicsClientId=client)
        p.addUserDebugText(f"Lugar {name}", pos + [0, 0, 0.25], textColorRGB=[1, 0, 0],
                           textSize=1.5, physicsClientId=client)
        p.addUserDebugLine([pos[0], pos[1], 0], pos, [0.3, 0.3, 1], 1, physicsClientId=client)


def run(port, num_drones, gui, demo, duration, output_folder):
    offsets = formation_offsets(num_drones)
    init_xyzs = PLACES["A"] * [1, 1, 0] + offsets + [0, 0, 0.05]   # en el suelo bajo el lugar A
    init_rpys = np.zeros((num_drones, 3))

    env = CtrlAviary(drone_model=DroneModel.CF2X, num_drones=num_drones,
                     initial_xyzs=init_xyzs, initial_rpys=init_rpys,
                     physics=Physics.PYB, pyb_freq=240, ctrl_freq=48,
                     gui=gui, record=False, obstacles=False, user_debug_gui=False)
    client = env.getPyBulletClient()
    ctrl = [DSLPIDControl(drone_model=DroneModel.CF2X) for _ in range(num_drones)]

    if gui:
        p.resetDebugVisualizerCamera(5.0, 45, -35, [1, 1, 0.5], physicsClientId=client)
        draw_places(client)

    link = None if demo else open_link(port, client)
    edges = EdgeDetector()
    smooth = LowPass(alpha=0.25, n=3)          # suaviza el joystick

    dt = env.CTRL_TIMESTEP
    center = PLACES["A"] * [1, 1, 0] + [0, 0, 0.05]   # setpoint del centro (empieza en el suelo)
    goal = PLACES["A"].copy()                         # al arrancar: despegar al lugar A
    goal_name, landed = "A", False
    demo_queue = ["B", "C"]                           # secuencia automatica en --demo
    log_rows = []

    action = np.zeros((num_drones, 4))
    start = time.time()
    n_steps = int(duration * env.CTRL_FREQ) if (demo or duration > 0) else 10 ** 9
    last_print = 0.0
    try:
        for i in range(n_steps):
            obs, *_ = env.step(action)
            t = i / env.CTRL_FREQ

            # ---------------- 1. Leer consola (o secuencia demo) ----------------
            if demo:
                if goal_name and np.linalg.norm(center - goal) < ARRIVE_TOL and t > 2 and demo_queue:
                    goal_name = demo_queue.pop(0)
                    goal = PLACES[goal_name].copy()
                elif not demo_queue and np.linalg.norm(center - goal) < ARRIVE_TOL:
                    print(f"[demo] llegada final a {goal_name} en t={t:.1f}s")
                    break
                lx = ly = ry = 0.0
            else:
                fr = link.read()
                pressed = edges.pressed(fr)
                for bit, name in ((BTN_A, "A"), (BTN_B, "B"), (BTN_C, "C")):
                    if pressed & bit:
                        goal, goal_name, landed = PLACES[name].copy(), name, False
                if pressed & BTN_D:
                    landed = not landed
                    if landed:
                        goal, goal_name = np.array([center[0], center[1], Z_MIN]), "suelo"
                    else:
                        goal, goal_name = np.array([center[0], center[1], 1.0]), "despegue"
                lx, ly, ry = smooth(fr.lx, fr.ly, fr.ry)
                link.send_led(landed)

                # joystick fuera de zona muerta -> control manual, cancela el "ir a"
                if max(abs(lx), abs(ly), abs(ry)) > STICK_ACTIVE and not landed:
                    goal_name = "manual"
                    goal = center + [lx * MANUAL_SPEED * dt, ly * MANUAL_SPEED * dt, ry * Z_SPEED * dt]

            # ---------------- 2. Setpoint con limite de velocidad ----------------
            vec = goal - center
            dist = np.linalg.norm(vec)
            step = GOTO_SPEED * dt if goal_name != "manual" else np.inf
            center = goal.copy() if dist <= step else center + vec / dist * step
            center[:2] = np.clip(center[:2], -XY_LIM, XY_LIM)
            center[2] = np.clip(center[2], Z_MIN, Z_MAX)

            # ---------------- 3. PID por dron hacia centro + offset --------------
            for j in range(num_drones):
                action[j, :], _, _ = ctrl[j].computeControlFromState(
                    control_timestep=dt, state=obs[j],
                    target_pos=center + offsets[j], target_rpy=np.zeros(3))

            mean_pos = obs[:, 0:3].mean(axis=0)
            log_rows.append([round(t, 3), *np.round(mean_pos, 3), goal_name])
            if t - last_print >= 1.0:
                last_print = t
                ok = "demo" if demo else ("ESP32 OK" if link.connected() else "SIN SENAL")
                print(f"t={t:5.1f}s  destino={goal_name:8s} centro_real={np.round(mean_pos, 2)}  [{ok}]")

            if gui:
                sync(i, start, dt)
    except KeyboardInterrupt:
        pass
    finally:
        env.close()
        if link:
            link.close()
        os.makedirs(output_folder, exist_ok=True)
        path = os.path.join(output_folder, "trayectoria_drones.csv")
        with open(path, "w", newline="") as f:
            w = csv.writer(f)
            w.writerow(["t", "x", "y", "z", "destino"])
            w.writerows(log_rows)
        print(f"Trayectoria guardada en {path}")


if __name__ == "__main__":
    ap = argparse.ArgumentParser(description="Drones controlados desde ESP32")
    ap.add_argument("--port", default=None, help="Puerto serie de la ESP32 (omitir = teclado)")
    ap.add_argument("--num_drones", type=int, default=5)
    ap.add_argument("--gui", type=str2bool, default=True)
    ap.add_argument("--demo", action="store_true", help="recorrido automatico A->B->C")
    ap.add_argument("--duration", type=float, default=0, help="segundos (0 = hasta Ctrl+C)")
    ap.add_argument("--output_folder", default="results")
    a = ap.parse_args()
    run(a.port, a.num_drones, a.gui, a.demo, a.duration if not a.demo else (a.duration or 90),
        a.output_folder)
