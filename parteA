"""
PARTE A
Control de un dron de gym-pybullet-drones mediante ESP32 por TCP.

Comandos:
    A,x,y,z
    STOP
"""

import socket
import threading
import time

import numpy as np

from gym_pybullet_drones.envs.VelocityAviary import VelocityAviary
from gym_pybullet_drones.utils.enums import DroneModel, Physics


HOST = "0.0.0.0"
PORT = 5000

COMMAND = np.zeros(3, dtype=np.float32)
LOCK = threading.Lock()
RUNNING = True


def clamp(value, low=-1.0, high=1.0):
    return max(low, min(high, value))


def parse_command(line):
    """Actualiza la referencia global a partir del protocolo."""
    global COMMAND, RUNNING

    line = line.strip()

    if not line:
        return "EMPTY"

    if line.upper() == "STOP":
        with LOCK:
            COMMAND[:] = 0.0
        return "OK STOP"

    parts = line.split(",")

    if len(parts) == 4 and parts[0].upper() == "A":
        try:
            x = clamp(float(parts[1]))
            y = clamp(float(parts[2]))
            z = clamp(float(parts[3]))
        except ValueError:
            return "ERROR NUMERIC"

        with LOCK:
            COMMAND[:] = [x, y, z]

        return "OK MOVE"

    return "ERROR COMMAND"


def client_worker(conn, address):
    print(f"[TCP] Cliente conectado: {address}")

    try:
        buffer = b""

        while RUNNING:
            data = conn.recv(1024)

            if not data:
                break

            buffer += data

            while b"\n" in buffer:
                raw, buffer = buffer.split(b"\n", 1)
                line = raw.decode("utf-8", errors="ignore")
                response = parse_command(line)
                conn.sendall((response + "\n").encode("utf-8"))

    except ConnectionResetError:
        pass
    finally:
        conn.close()
        print(f"[TCP] Cliente desconectado: {address}")


def start_server():
    server = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    server.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    server.bind((HOST, PORT))
    server.listen(2)

    print(f"[TCP] Servidor escuchando en {HOST}:{PORT}")

    while RUNNING:
        conn, address = server.accept()
        thread = threading.Thread(
            target=client_worker,
            args=(conn, address),
            daemon=True
        )
        thread.start()


def main():
    global RUNNING

    env = VelocityAviary(
        drone_model=DroneModel.CF2X,
        num_drones=1,
        initial_xyzs=np.array([[0.0, 0.0, 0.3]]),
        initial_rpys=np.array([[0.0, 0.0, 0.0]]),
        physics=Physics.PYB,
        pyb_freq=240,
        ctrl_freq=48,
        gui=True,
        record=False,
        obstacles=False,
        user_debug_gui=False,
    )

    action = np.zeros((1, 4), dtype=np.float32)

    server_thread = threading.Thread(target=start_server, daemon=True)
    server_thread.start()

    print("PARTE A lista.")
    print("Conecte la ESP32 al mismo Wi-Fi.")
    print("Ctrl+C para finalizar.")

    try:
        while True:
            with LOCK:
                x, y, z = COMMAND

            magnitude = min(
                1.0,
                float(np.sqrt(x * x + y * y + z * z))
            )

            if magnitude > 1e-6:
                action[0, 0:3] = [x, y, z]
                action[0, 3] = magnitude
            else:
                action[0, :] = 0.0

            env.step(action)
            env.render()

            time.sleep(env.CTRL_TIMESTEP)

    except KeyboardInterrupt:
        print("\nFinalizando...")

    finally:
        env.close()
        RUNNING = False


if __name__ == "__main__":
    main()
