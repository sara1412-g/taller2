"""
Parte B - Baxter: movilidad real de brazos, posicionamiento y pick & place con la ESP32.

Consola ESP32                              Teclado (si se omite --port)
  Joystick izq: lx -> izquierda/derecha     A / D
                ly -> adelante/atras        W / S
  Joystick der: ry -> subir/bajar mano      I / K
  Boton A -> cerrar/abrir pinza (agarra el cubo si esta a < 10 cm)     1
  Boton B -> cambiar de brazo (izquierdo <-> derecho)                  2
  Boton C -> volver el brazo activo a su pose inicial                  3
  Boton D -> reponer el cubo en su posicion inicial                    4

Los ejes se interpretan en el marco del robot: "adelante" es hacia donde mira Baxter.
Cada brazo se mueve con cinematica inversa (IK) hacia un objetivo (esfera roja) que el
joystick desplaza con velocidad limitada y filtro paso-bajo -> movimiento fluido.

Uso:
  python esp32_baxter.py --port COM5
  python esp32_baxter.py                  # teclado
  python esp32_baxter.py --auto           # demostracion automatica de pick & place
  python esp32_baxter.py --list-joints    # imprime la tabla de articulaciones del URDF
"""
import argparse
import os
import sys
import time

import numpy as np
import pybullet as p
import pybullet_data

sys.path.insert(0, os.path.join(os.path.dirname(__file__), ".."))
from common.baxter_lib import (BASE_YAW0, IK_RATE, BaxterRobot, make_marker,  # noqa: E402
                               make_pedestal)
from common.esp32_link import BTN_A, BTN_B, BTN_C, BTN_D, EdgeDetector, LowPass, open_link  # noqa: E402

SIM_HZ = 240
CUBE_URDF = "cube_small.urdf"


def build_scene(client, robot):
    """Pedestal con un cubo y una placa de destino, ubicados respecto a la pose inicial de la mano."""
    home = robot.arms["left"].home_local
    top_z = home[2] - 0.14                                   # cara superior del pedestal (local)
    quat = p.getQuaternionFromEuler([0, 0, BASE_YAW0 + robot.yaw])
    plane_z = -1.0
    half = [0.25, 0.30, (top_z - plane_z) / 2]
    center_local = [home[0] + 0.10, home[1] - 0.10, plane_z + half[2]]
    make_pedestal(client, robot.local_to_world(center_local).tolist(), half, quat)

    cube_local = np.array([home[0] + 0.10, home[1], top_z + 0.03])
    goal_local = np.array([home[0] + 0.10, home[1] - 0.20, top_z + 0.003])
    cube_start = robot.local_to_world(cube_local)
    cube = p.loadURDF(CUBE_URDF, cube_start.tolist(), globalScaling=0.8, physicsClientId=client)
    p.changeVisualShape(cube, -1, rgbaColor=[0.1, 0.4, 1, 1], physicsClientId=client)
    make_marker(client, robot.local_to_world(goal_local).tolist(), 0.05, (1, 0.8, 0, 0.9))
    return cube, cube_start, robot.local_to_world(goal_local)


def auto_demo(robot, cube, goal_world, client):
    """Secuencia automatica: ir al cubo, agarrar, llevarlo al destino, soltar."""
    arm = robot.arms["left"]
    cpos = np.array(p.getBasePositionAndOrientation(cube, physicsClientId=client)[0])
    above = robot.world_to_local(cpos + [0, 0, 0.08])
    at = robot.world_to_local(cpos + [0, 0, 0.0])
    dest = robot.world_to_local(goal_world + [0, 0, 0.05])
    dest_up = dest + [0, 0, 0.08]
    steps = [("sobre el cubo", above), ("bajar", at), ("agarrar", None),
             ("subir", above), ("transportar", dest_up), ("bajar", dest), ("soltar", None)]
    return arm, steps


def run(port, auto, gui=True):
    client = p.connect(p.GUI if gui else p.DIRECT)
    p.setAdditionalSearchPath(pybullet_data.getDataPath())
    p.setGravity(0, 0, -10, physicsClientId=client)
    p.setPhysicsEngineParameter(fixedTimeStep=1.0 / SIM_HZ, physicsClientId=client)
    p.loadURDF("plane.urdf", [0, 0, -1], useFixedBase=True, physicsClientId=client)
    robot = BaxterRobot(client, base_pos=(0.5, -0.8, 0.0), base_yaw=0.0)
    cube, cube_start, goal_world = build_scene(client, robot)
    p.resetDebugVisualizerCamera(2.2, 25, -25, [0.5, -0.1, -0.1], physicsClientId=client)

    target_vis = p.createMultiBody(0, -1, p.createVisualShape(
        p.GEOM_SPHERE, radius=0.02, rgbaColor=[1, 0, 0, 0.8], physicsClientId=client),
        [0, 0, 0], physicsClientId=client)
    hud = None

    link = None if auto else open_link(port, client)
    edges, smooth = EdgeDetector(), LowPass(0.25, 3)
    active = "left"
    dt = 1.0 / IK_RATE
    sub = int(SIM_HZ / IK_RATE)

    if auto:
        arm_a, plan = auto_demo(robot, cube, goal_world, client)
        plan_i, settle = 0, 0

    print("Listo. Brazo activo: left. (Ctrl+C para salir)")
    t0 = time.time()
    k = 0
    try:
        while True:
            for _ in range(sub):
                p.stepSimulation(physicsClientId=client)
            k += 1
            arm = robot.arms[active]

            if auto:
                if plan_i >= len(plan):
                    for _ in range(SIM_HZ):          # 1 s para que el cubo se asiente
                        p.stepSimulation(physicsClientId=client)
                    pos = np.array(p.getBasePositionAndOrientation(cube, physicsClientId=client)[0])
                    print(f"[auto] fin. Cubo a {np.linalg.norm(pos - goal_world):.3f} m del destino")
                    break
                name, tgt = plan[plan_i]
                if tgt is None:
                    robot.toggle_grip(arm_a, [cube])
                    settle = 0
                    plan_i += 1
                else:
                    arm_a.target_local += np.clip(tgt - arm_a.target_local, -0.4 * dt, 0.4 * dt)
                    if np.linalg.norm(tgt - arm_a.target_local) < 0.01:
                        settle += 1
                        if settle > 30:
                            settle, plan_i = 0, plan_i + 1
            else:
                fr = link.read()
                pr = edges.pressed(fr)
                if pr & BTN_B:
                    active = "right" if active == "left" else "left"
                    arm = robot.arms[active]
                    print("Brazo activo:", active)
                if pr & BTN_A:
                    held = robot.toggle_grip(arm, [cube])
                    link.send_led(arm.closed)
                    print(f"Pinza {'cerrada' if arm.closed else 'abierta'}"
                          f"{' - OBJETO AGARRADO' if held else ''}")
                if pr & BTN_C:
                    robot.go_home(arm)
                if pr & BTN_D and arm.held is None:
                    p.resetBasePositionAndOrientation(cube, cube_start.tolist(), [0, 0, 0, 1],
                                                      physicsClientId=client)
                lx, ly, ry = smooth(fr.lx, fr.ly, fr.ry)
                # stick arriba -> adelante (+x local); stick derecha -> derecha del robot (-y local)
                robot.move_target(arm, [ly, -lx, ry], dt)

            for a in robot.arms.values():
                robot.update_arm(a)
            p.resetBasePositionAndOrientation(
                target_vis, robot.local_to_world(robot.arms[active].target_local).tolist(),
                [0, 0, 0, 1], physicsClientId=client)

            if gui and k % 15 == 0:
                state = "cerrada" if robot.arms[active].closed else "abierta"
                ok = "AUTO" if auto else ("ESP32 OK" if link.connected() else "SIN SENAL")
                hud = p.addUserDebugText(f"Brazo: {active} | Pinza: {state} | {ok}",
                                         [0.0, -0.8, 0.9], textColorRGB=[0, 0, 0], textSize=1.4,
                                         replaceItemUniqueId=hud if hud is not None else -1,
                                         physicsClientId=client)
            # sincronizacion con el reloj (tiempo real)
            wait = t0 + k / IK_RATE - time.time()
            if gui and wait > 0:
                time.sleep(wait)
    except KeyboardInterrupt:
        pass
    finally:
        if link:
            link.close()
        p.disconnect(client)


if __name__ == "__main__":
    ap = argparse.ArgumentParser(description="Baxter + ESP32 (parte B)")
    ap.add_argument("--port", default=None, help="puerto serie de la ESP32 (omitir = teclado)")
    ap.add_argument("--auto", action="store_true", help="demo automatica de pick & place")
    ap.add_argument("--headless", action="store_true", help="sin ventana (solo con --auto)")
    ap.add_argument("--list-joints", action="store_true")
    a = ap.parse_args()
    if a.list_joints:
        c = p.connect(p.DIRECT)
        BaxterRobot(c).list_joints()
    else:
        run(a.port, a.auto, gui=not a.headless)
