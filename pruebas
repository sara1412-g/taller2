"""Pruebas del protocolo y del enlace serie (sin hardware ni simulador).

Ejecutar desde la raiz del repo:   python -m unittest discover -s tests -v
(En Windows la prueba con pseudo-terminal se omite automaticamente.)
"""
import os
import sys
import time
import unittest

sys.path.insert(0, os.path.join(os.path.dirname(__file__), ".."))
from common.esp32_link import (BTN_A, BTN_C, EdgeDetector, Frame, LowPass,  # noqa: E402
                               SerialLink, build_line, parse_line)


class TestProtocol(unittest.TestCase):
    def test_roundtrip(self):
        f = parse_line(build_line(500, -1000, 0, 250, BTN_A | BTN_C))
        self.assertEqual(f, Frame(0.5, -1.0, 0.0, 0.25, 5))

    def test_bad_checksum(self):
        self.assertIsNone(parse_line("$J,1,2,3,4,0*00\n"))

    def test_garbage(self):
        for s in ("", "hola", "$J,1,2*00", "$X,1,2,3,4,5*00", "$J,a,b,c,d,e*00"):
            self.assertIsNone(parse_line(s))

    def test_clamp(self):
        self.assertEqual(parse_line(build_line(5000, -5000, 0, 0, 0)).lx, 1.0)

    def test_edges(self):
        e = EdgeDetector()
        self.assertEqual(e.pressed(Frame(btn=1)), 1)
        self.assertEqual(e.pressed(Frame(btn=1)), 0)   # mantener pulsado no repite
        self.assertEqual(e.pressed(Frame(btn=0)), 0)
        self.assertEqual(e.pressed(Frame(btn=1)), 1)

    def test_lowpass_converges(self):
        lp = LowPass(0.3)
        for _ in range(60):
            y = lp(1.0)
        self.assertAlmostEqual(y, 1.0, places=3)


@unittest.skipUnless(os.name == "posix", "requiere pseudo-terminal POSIX")
class TestSerial(unittest.TestCase):
    def test_pty_link_and_failsafe(self):
        import pty
        master, slave = pty.openpty()
        link = SerialLink(os.ttyname(slave))
        os.write(master, b"basura\n")                          # linea invalida
        os.write(master, build_line(1000, 0, 0, -1000, 2).encode())
        time.sleep(0.4)
        f = link.read()
        self.assertEqual((f.lx, f.ry, f.btn), (1.0, -1.0, 2))
        self.assertGreaterEqual(link.bad_frames, 1)
        time.sleep(0.7)                                         # sin tramas -> failsafe
        self.assertEqual(link.read(), Frame())
        link.close()


if __name__ == "__main__":
    unittest.main()
